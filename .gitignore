# Compiled binaries (C/ASM exercises)
*.o
*.out
*.bin

# ELF executables without extension (compiled exercises)
notes/reverse-engineering/lecon/[a-z]*
notes/reverse-engineering/lecon1
notes/reverse-engineering/exercice*
!notes/reverse-engineering/exercice*.c
!notes/reverse-engineering/lecon/*.c

# PDFs are tracked — but keep this rule ready if needed
# *.pdf

# Metasploit / pentesting artifacts
*.rc.local
loot/
*.loot
*.msf4
*.log

# msfvenom payloads
*.exe
*.apk
*.elf
*.war
*.raw
*.ps1

# Docker
.docker/

# OS
.DS_Store
Thumbs.db
*~
.swp
.swo

# IDE
.vscode/
.idea/
*.code-workspace
